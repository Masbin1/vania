<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incentive_transaction_refund_form" model="ir.ui.view">
        <field name="name">incentive.transaction.refund.form</field>
        <field name="model">incentive.transaction.refund</field>
        <field name="arch" type="xml">
            <form string="Refund Invoice">
                <group>
                    <group>
                        <field name="move_id" readonly="1"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="move_line_id" readonly="1" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="base_amount" readonly="1"/>
                        <field name="refundable_amount" readonly="1"/>
                        <field name="refund_amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_refund" type="object"
                            string="Create Credit Note &amp; Refund" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
