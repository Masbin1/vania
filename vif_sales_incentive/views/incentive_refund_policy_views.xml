<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incentive_refund_policy_tree" model="ir.ui.view">
        <field name="name">incentive.refund.policy.tree</field>
        <field name="model">incentive.refund.policy</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stock_type"/>
                <field name="is_wip" widget="boolean_toggle"/>
                <field name="payment_status"/>
                <field name="initiator"/>
                <field name="refund_pct"/>
                <field name="by_agreement" widget="boolean_toggle"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_incentive_refund_policy" model="ir.actions.act_window">
        <field name="name">Refund Policies</field>
        <field name="res_model">incentive.refund.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
