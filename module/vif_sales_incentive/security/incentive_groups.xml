    <record id="group_incentive_user" model="res.groups">
        <field name="name">Salesperson (own data)</field>
        <field name="comment">S19: sees only own target, achievement and calculated incentive.</field>
    </record>

    <record id="group_incentive_manager" model="res.groups">
        <field name="name">Sales Manager (subordinates)</field>
        <field name="implied_ids" eval="[(4, ref('group_incentive_user'))]"/>
        <field name="comment">S20: sees own data plus every direct and indirect subordinate.</field>
    </record>

    <record id="group_incentive_admin" model="res.groups">
        <field name="name">Incentive Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_incentive_manager'))]"/>
        <field name="comment">Finance / C-level. Full configuration, calculation, approval and lock.</field>
    </record>

</odoo>
