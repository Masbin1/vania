<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incentive_branch_tree" model="ir.ui.view">
        <field name="name">incentive.branch.tree</field>
        <field name="model">incentive.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="ideal_team_size"/>
                <field name="employee_count"/>
                <field name="effective_fte"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_incentive_branch_form" model="ir.ui.view">
        <field name="name">incentive.branch.form</field>
        <field name="model">incentive.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Jakarta"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="ideal_team_size"/>
                            <field name="effective_fte"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales Team">
                            <field name="employee_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="incentive_business_type"/>
                                    <field name="incentive_designation_id"/>
                                    <field name="is_vacant_slot"/>
                                    <field name="incentive_date_start"/>
                                    <field name="incentive_date_end"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_incentive_branch" model="ir.actions.act_window">
        <field name="name">Sales Branches</field>
        <field name="res_model">incentive.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
